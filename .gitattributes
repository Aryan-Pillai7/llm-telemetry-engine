# Normalize line endings to LF in the repository.
#
# Config files and scripts in this repo are bind-mounted into Linux containers
# (otelcol, ClickHouse, Grafana). CRLF in a mounted shell script or YAML file
# fails in ways that are tedious to diagnose, so the repo is LF everywhere and
# Git handles the developer's working copy.
* text=auto eol=lf

# Files that must stay LF even in the working copy on Windows.
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sql  text eol=lf
*.xml  text eol=lf
*.py   text eol=lf

# Windows-native scripts keep CRLF.
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Never touch these.
*.parquet binary
*.png     binary
*.jpg     binary
*.gz      binary
*.zst     binary
