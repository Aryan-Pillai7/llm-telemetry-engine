# Copy to .env only if you need to override a default.
# The defaults in src/telemetry_engine/config.py already target the local
# docker compose stack, so a fresh clone works with no .env at all.
#
# Format: TE_<SECTION>__<FIELD>

# --- Redpanda ---------------------------------------------------------------
# Use localhost:19092 from the host, redpanda:9092 from inside the compose net.
#TE_REDPANDA__BOOTSTRAP_SERVERS=localhost:19092
#TE_REDPANDA__SPANS_TOPIC=otel.spans
#TE_REDPANDA__PARTITIONS=6
#TE_REDPANDA__RETENTION_HOURS=6

# --- ClickHouse -------------------------------------------------------------
#TE_CLICKHOUSE__HOST=localhost
#TE_CLICKHOUSE__HTTP_PORT=8123
#TE_CLICKHOUSE__DATABASE=telemetry
#TE_CLICKHOUSE__USER=default
#TE_CLICKHOUSE__PASSWORD=
# How long raw high-cardinality spans stay in the hot tier.
#TE_CLICKHOUSE__RAW_TTL_HOURS=48

# --- Cold tier --------------------------------------------------------------
#TE_COLDTIER__ROOT=./data/cold
#TE_COLDTIER__TARGET_FILE_MB=128

# --- Synthetic workload -----------------------------------------------------
#TE_WORKLOAD__TENANTS=50
#TE_WORKLOAD__ZIPF_ALPHA=1.2
#TE_WORKLOAD__SUSTAINED_SPANS_PER_SEC=5000
#TE_WORKLOAD__BURST_SPANS_PER_SEC=20000

# --- Misc -------------------------------------------------------------------
#TE_LOG_LEVEL=INFO
