<?xml version="1.0"?>
<!--
  Server-level limits for a single-node ClickHouse sharing a laptop.

  The container has a 2 GiB cgroup limit. ClickHouse reads that limit, but its
  defaults still assume it owns the machine, so caches and background pools are
  sized down explicitly here.
-->
<clickhouse>
    <!-- Ceiling for all queries combined, as a fraction of the cgroup limit.
         Leaves room for caches, background merges, and the Kafka consumers. -->
    <max_server_memory_usage_to_ram_ratio>0.75</max_server_memory_usage_to_ram_ratio>

    <!-- 256 MiB of mark cache is plenty at this data volume. The uncompressed
         cache is off: telemetry queries are scan-heavy over recent data with
         little repeat access, so it would evict marks for no benefit. -->
    <mark_cache_size>268435456</mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>

    <!-- Background merge pool. Merges are how MergeTree keeps part counts
         under control; starving this pool while the Kafka engine inserts
         steadily is the classic "too many parts" failure. -->
    <background_pool_size>8</background_pool_size>
    <background_schedule_pool_size>8</background_schedule_pool_size>

    <!-- Threads that drive Kafka table engine consumers. Must be >= the total
         kafka_num_consumers across all Kafka tables, or consumption silently
         serializes and lag grows for reasons that look like broker trouble. -->
    <background_message_broker_schedule_pool_size>8</background_message_broker_schedule_pool_size>

    <merge_tree>
        <!-- These thresholds reserve free slots in the merge pool before
             ClickHouse will start a mutation or a whole-partition optimize.
             Their defaults (20 and 25) assume the default pool of 64; against
             the small pool above, ClickHouse refuses to start rather than
             deadlock. Scaled down to match rather than inflating the pool,
             because merge threads on a laptop compete with the ingest path.
             The sanity check is: this value must be <= background_pool_size *
             background_merges_mutations_concurrency_ratio (8 * 2 = 16). -->
        <number_of_free_entries_in_pool_to_execute_mutation>4</number_of_free_entries_in_pool_to_execute_mutation>
        <number_of_free_entries_in_pool_to_execute_optimize_entire_partition>4</number_of_free_entries_in_pool_to_execute_optimize_entire_partition>
        <number_of_free_entries_in_pool_to_lower_max_size_of_merge>2</number_of_free_entries_in_pool_to_lower_max_size_of_merge>
    </merge_tree>

    <logger>
        <level>information</level>
        <console>1</console>
    </logger>
</clickhouse>
