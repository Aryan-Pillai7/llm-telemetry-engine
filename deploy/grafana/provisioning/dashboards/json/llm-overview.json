{
  "uid": "llm-overview",
  "title": "LLM Telemetry - Overview",
  "description": "Workload view: throughput, latency, cache pressure, per-tenant breakdown.",
  "tags": [
    "llm-telemetry"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Spans/sec",
      "description": "Span rate over the selected window. Spans, not requests: one agent invocation produces several.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-telemetry"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-telemetry"
          },
          "editorType": "sql",
          "format": 1,
          "meta": {
            "builderOptions": {
              "fields": [],
              "limit": 100,
              "mode": "list"
            }
          },
          "queryType": "sql",
          "rawSql": "SELECT countMerge(spans) / 60 AS value FROM telemetry.spans_1m WHERE $__timeFilter(ts_minute)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Traces",
      "description": "Distinct traces (approximate, from mergeable uniq states).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-telemetry"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-telemetry"
          },
          "editorType": "sql",
          "format": 1,
          "meta": {
            "builderOptions": {
              "fields": [],
              "limit": 100,
              "mode": "list"
            }
          },
          "queryType": "sql",
          "rawSql": "SELECT uniqMerge(traces) AS value FROM telemetry.spans_1m WHERE $__timeFilter(ts_minute)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Output tokens/sec",
      "description": "Generated tokens per second: the throughput number that maps most directly to serving cost.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-telemetry"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-telemetry"
          },
          "editorType": "sql",
          "format": 1,
          "meta": {
            "builderOptions": {
              "fields": [],
              "limit": 100,
              "mode": "list"
            }
          },
          "queryType": "sql",
          "rawSql": "SELECT sumMerge(output_tokens) / 60 AS value\nFROM telemetry.spans_1m WHERE $__timeFilter(ts_minute)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error rate",
      "description": "Share of spans whose status_class is not ok.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-telemetry"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.02
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-telemetry"
          },
          "editorType": "sql",
          "format": 1,
          "meta": {
            "builderOptions": {
              "fields": [],
              "limit": 100,
              "mode": "list"
            }
          },
          "queryType": "sql",
          "rawSql": "SELECT countIfMerge(errors) / nullIf(countMerge(spans), 0) AS value\nFROM telemetry.spans_1m WHERE $__timeFilter(ts_minute)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "KV-cache utilization (max)",
      "description": "Peak KV-cache occupancy. Above ~0.85 the scheduler starts queueing, which is the mechanism behind most TTFT spikes.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-telemetry"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-telemetry"
          },
          "editorType": "sql",
          "format": 1,
          "meta": {
            "builderOptions": {
              "fields": [],
              "limit": 100,
              "mode": "list"
            }
          },
          "queryType": "sql",
          "rawSql": "SELECT maxMerge(kv_cache_max) AS value FROM telemetry.spans_1m WHERE $__timeFilter(ts_minute)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Active tenants",
      "description": "Individually attributed tenants. Excludes the sentinel buckets, so this counts tenants you can actually name.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-telemetry"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-telemetry"
          },
          "editorType": "sql",
          "format": 1,
          "meta": {
            "builderOptions": {
              "fields": [],
              "limit": 100,
              "mode": "list"
            }
          },
          "queryType": "sql",
          "rawSql": "SELECT uniqExact(tenant_id) AS value FROM telemetry.spans_1m\nWHERE $__timeFilter(ts_minute) AND tenant_id NOT IN ('__other__', '__none__')",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Token throughput",
      "description": "Input and output tokens per minute. The cost signal.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-telemetry"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-telemetry"
          },
          "editorType": "sql",
          "format": 2,
          "meta": {
            "builderOptions": {
              "fields": [],
              "limit": 100,
              "mode": "list"
            }
          },
          "queryType": "sql",
          "rawSql": "SELECT ts_minute AS time,\n       sumMerge(input_tokens) AS \"input tokens\",\n       sumMerge(output_tokens) AS \"output tokens\"\nFROM telemetry.spans_1m WHERE $__timeFilter(ts_minute)\nGROUP BY time ORDER BY time",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Time to first token",
      "description": "What a user actually perceives as latency.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-telemetry"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-telemetry"
          },
          "editorType": "sql",
          "format": 2,
          "meta": {
            "builderOptions": {
              "fields": [],
              "limit": 100,
              "mode": "list"
            }
          },
          "queryType": "sql",
          "rawSql": "SELECT ts_minute AS time,\n       quantilesTDigestMerge(0.5)(ttft)[1] AS p50,\n       quantilesTDigestMerge(0.95)(ttft)[1] AS p95,\n       quantilesTDigestMerge(0.99)(ttft)[1] AS p99\nFROM telemetry.spans_1m WHERE $__timeFilter(ts_minute)\nGROUP BY time ORDER BY time",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "TTFT p95 by model",
      "description": "Bigger models are slower per token, so these series should stay ordered by model size. They crossing over means something changed.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-telemetry"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-telemetry"
          },
          "editorType": "sql",
          "format": 2,
          "meta": {
            "builderOptions": {
              "fields": [],
              "limit": 100,
              "mode": "list"
            }
          },
          "queryType": "sql",
          "rawSql": "SELECT ts_minute AS time, model,\n       quantilesTDigestMerge(0.95)(ttft)[1] AS p95\nFROM telemetry.spans_1m\nWHERE $__timeFilter(ts_minute) AND model NOT IN ('__none__')\nGROUP BY time, model ORDER BY time",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "KV-cache utilization",
      "description": "Average and peak occupancy. The gap between them explains latency that an average alone makes look fine.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-telemetry"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-telemetry"
          },
          "editorType": "sql",
          "format": 2,
          "meta": {
            "builderOptions": {
              "fields": [],
              "limit": 100,
              "mode": "list"
            }
          },
          "queryType": "sql",
          "rawSql": "SELECT ts_minute AS time,\n       avgMerge(kv_cache_avg) AS \"avg\",\n       maxMerge(kv_cache_max) AS \"max\"\nFROM telemetry.spans_1m WHERE $__timeFilter(ts_minute)\nGROUP BY time ORDER BY time",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Top tenants",
      "description": "Zipfian by design: a handful of tenants dominate every window.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-telemetry"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-telemetry"
          },
          "editorType": "sql",
          "format": 1,
          "meta": {
            "builderOptions": {
              "fields": [],
              "limit": 100,
              "mode": "list"
            }
          },
          "queryType": "sql",
          "rawSql": "SELECT tenant_id AS \"tenant\",\n       any(tenant_tier) AS \"tier\",\n       countMerge(spans) AS \"span count\",\n       uniqMerge(traces) AS \"trace count\",\n       sumMerge(output_tokens) AS \"output tokens\",\n       round(quantilesTDigestMerge(0.95)(ttft)[1], 1) AS \"ttft p95 (ms)\",\n       round(countIfMerge(errors) / nullIf(countMerge(spans), 0), 4) AS \"error rate\"\nFROM telemetry.spans_1m WHERE $__timeFilter(ts_minute)\nGROUP BY tenant_id ORDER BY \"span count\" DESC LIMIT 20",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Errors by class",
      "description": "server_error and timeout cluster under KV-cache pressure.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-telemetry"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-telemetry"
          },
          "editorType": "sql",
          "format": 2,
          "meta": {
            "builderOptions": {
              "fields": [],
              "limit": 100,
              "mode": "list"
            }
          },
          "queryType": "sql",
          "rawSql": "SELECT ts_minute AS time, status_class,\n       countMerge(spans) AS \"error spans\"\nFROM telemetry.spans_1m\nWHERE $__timeFilter(ts_minute) AND status_class != 'ok'\nGROUP BY time, status_class ORDER BY time",
          "refId": "A"
        }
      ]
    }
  ]
}
